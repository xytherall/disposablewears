# Copy this file to .env.local and fill in the values from
# Supabase > Project Settings > API Keys (used from Phase 3).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Your live website address, e.g. https://disposablewears.pk
NEXT_PUBLIC_SITE_URL=

# New-order email alerts (optional, free at resend.com). Without a verified
# domain, alerts can only go to the email you signed up to Resend with.
RESEND_API_KEY=
# Defaults to the email in admin Settings.
ORDER_ALERT_EMAIL=
